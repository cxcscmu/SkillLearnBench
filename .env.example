# Copy this file to .env and fill in your API keys.

# Evaluation
# Anthropic API Key, get from: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API Key, get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Required for task: github-repo-analytics.
# Github Token, get from: https://github.com/settings/tokens
GH_TOKEN=your-github-token-here

# Optional: Skill Generation 
# Google API Key, get from: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here
